{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm install --no-audit --no-fund && npm run build && mkdir -p public_dist && cp -r public/build public/favicon.ico public/robots.txt public_dist/",
    "installCommand": null,
    "outputDirectory": "public_dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 1024,
            "maxDuration": 60,
            "includeFiles": "{app,bootstrap,config,database,lang,public,resources,routes,storage/framework}/**"
        }
    },
    "rewrites": [
        { "source": "/build/:path*", "destination": "/build/:path*" },
        { "source": "/favicon.ico", "destination": "/favicon.ico" },
        { "source": "/robots.txt", "destination": "/robots.txt" },
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "headers": [
        {
            "source": "/build/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
            ]
        }
    ]
}
