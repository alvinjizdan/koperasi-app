# =====================================================================
# Template environment Docker (KSP Bima Sakti Mandiri)
# Salin menjadi .env.docker lalu isi nilai nyata. JANGAN commit .env.docker.
# Dipakai docker-compose.yml via env_file (app + db + ngrok).
# =====================================================================

# ---------- Aplikasi ----------
APP_NAME="KSP Bima Sakti Mandiri"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Saat demo via ngrok HTTPS, ganti sesuai URL tunnel, mis. https://xxxx.ngrok-free.app
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_OPERATIONAL_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------- Logging (stderr agar terlihat di docker logs) ----------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------- Database (service "db" di docker-compose) ----------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ksp_bima_sakti_docker
DB_USERNAME=ksp_docker
DB_PASSWORD=ubah_password_db_ini

# Kredensial inisialisasi container PostgreSQL (harus konsisten dengan DB_* di atas)
POSTGRES_DB=ksp_bima_sakti_docker
POSTGRES_USER=ksp_docker
POSTGRES_PASSWORD=ubah_password_db_ini

# ---------- Session & cache (driver database — server-safe) ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Default tidak diset => cookie secure mengikuti skema request (http localhost tetap bisa login).
# Untuk demo HTTPS-only via ngrok, aktifkan baris berikut:
# SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---------- Filesystem ----------
FILESYSTEM_DISK=local

# ---------- Mail (log-only untuk demo) ----------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Ngrok (opsional; aktif dengan: docker compose --profile tunnel up -d) ----------
# Ambil authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# JANGAN commit token: isi di .env.docker lokal saja.
NGROK_AUTHTOKEN=
# Opsional: domain statis untuk akun berbayar; akun gratis = URL acak tiap restart tunnel
NGROK_DOMAIN=

# ---------- Frontend ----------
VITE_APP_NAME="${APP_NAME}"

# ---------- Kontrol entrypoint container ----------
# Migrasi TIDAK pernah jalan otomatis; set true sekali untuk migrasi terkontrol.
RUN_MIGRATIONS=false
# Cache config/route/view saat start (aman untuk production, butuh APP_KEY terisi)
OPTIMIZE_CACHE=true

# ---------- Trusted proxy (HTTPS di belakang ngrok) ----------
# '*' = percaya proxy pada jaringan internal container ini saja (private).
TRUST_PROXIES=*
